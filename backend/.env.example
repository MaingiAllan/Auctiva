# Provide these as backend process environment variables; never commit populated values.
AUCTIVA_FRONTEND_URL=http://localhost:3000
AUCTIVA_OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# Google OAuth web client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Apple Services ID and generated Sign in with Apple client-secret JWT
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# Cloudflare Turnstile secret paired with NEXT_PUBLIC_TURNSTILE_SITE_KEY in web/.env.local
AUCTIVA_TURNSTILE_SECRET_KEY=

# SMTP account for email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
